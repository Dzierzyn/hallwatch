# Copy to .env and fill in what you use. Load before running:  source .env
# Secrets do NOT belong in config.yaml - the config may be committed, keys never.

# S3-compatible backup storage (Cloudflare R2 / Backblaze B2 / MinIO / AWS S3)
export HALLWATCH_S3_KEY=""
export HALLWATCH_S3_SECRET=""

# Keeping the camera URL here too means the password never sits in config.yaml:
#   hallwatch run --source "$HALLWATCH_RTSP"
export HALLWATCH_RTSP="rtsp://user:password@192.168.1.50:554/stream1"

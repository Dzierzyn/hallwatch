# Skopiuj do .env i uzupelnij. Wczytaj przed uruchomieniem:  source .env
# Klucze NIE naleza do config.yaml - config trafia do repo, klucze nie.

# Storage S3-compatible (Cloudflare R2 / Backblaze B2 / MinIO / AWS S3)
export HALLWATCH_S3_KEY=""
export HALLWATCH_S3_SECRET=""

# Wygodnie trzymac tu tez URL kamery, zeby haslo nie siedzialo w config.yaml:
#   hallwatch run --source "$HALLWATCH_RTSP"
export HALLWATCH_RTSP="rtsp://user:haslo@192.168.1.50:554/h264Preview_01_main"

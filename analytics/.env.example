# Skopiuj do .env i uzupelnij dla targetu prod:  set -a && . ./.env && set +a

# dev = DuckDB lokalnie, prod = BigQuery
export HW_TARGET=dev

# --- BigQuery / GCS (tylko dla HW_TARGET=prod) ---
export HW_GCP_PROJECT=""          # np. hallwatch-analytics
export HW_BQ_DATASET="hallwatch"  # powstana hallwatch_raw, _staging, _marts, _ml
export HW_BQ_LOCATION="EU"
export HW_GCS_BUCKET=""           # np. hallwatch-raw-<cos-unikalnego>

# Poswiadczenia: uzywamy ADC z gcloud, zadnych plikow z kluczami w repo
#   gcloud auth application-default login

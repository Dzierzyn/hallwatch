# Copy to .env and fill in for the prod target:  set -a && . ./.env && set +a

# dev = DuckDB locally, prod = BigQuery
export HW_TARGET=dev

# --- BigQuery / GCS (only for HW_TARGET=prod) ---
export HW_GCP_PROJECT=""          # e.g. hallwatch-analytics
export HW_BQ_DATASET="hallwatch"  # creates hallwatch_raw, _staging, _marts, _ml
export HW_BQ_LOCATION="EU"
export HW_GCS_BUCKET=""           # e.g. hallwatch-raw-<something-unique>

# Credentials: we use ADC from gcloud, no key files in the repo
#   gcloud auth application-default login
